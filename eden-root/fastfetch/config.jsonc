{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#50d890",
      "2": "#b89a6a",
      "3": "#ff6b6b",
      "4": "#d8b98a"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#50d890",
      "output": "#e2f2e4"
    },
    "key": {
      "width": 11
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "#50d890",
        "yellow": "#e8d27a",
        "red": "#ff6b6b"
      }
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "┄"
      },
      "border": {
        "left": "⟨",
        "right": "⟩"
      },
      "color": {
        "total": "#12291c",
        "border": "#72a084"
      },
      "width": 12
    }
  },
  "modules": [
    {"type": "custom", "format": "─⟨ GENESIS ⟩────────────────────────────", "outputColor": "#e8f0d0"},
    {"type": "title", "key": "• NODE", "format": "{user-name}@{host-name}"},
    {"type": "os", "key": "• OS", "format": "{name} {arch}"},
    {"type": "kernel", "key": "• KERNEL"},
    {"type": "uptime", "key": "• UPTIME"},
    {"type": "packages", "key": "• PKGS"},
    {"type": "shell", "key": "• SHELL"},
    {"type": "wm", "key": "• WM"},
    {"type": "terminal", "key": "• TERM"},
    {"type": "custom", "format": "─⟨ ROOTS ⟩──────────────────────────────", "outputColor": "#e8f0d0"},
    {"type": "cpu", "key": "• CPU", "format": "{name} ×{cores-logical}"},
    {"type": "gpu", "key": "• GPU", "format": "{name}"},
    {"type": "memory", "key": "• RAM"},
    {"type": "disk", "key": "• DISK", "folders": "/"},
    {"type": "battery", "key": "• POWER"},
    {"type": "custom", "format": "─⟨ RIVERS ⟩─────────────────────────────", "outputColor": "#e8f0d0"},
    {"type": "localip", "key": "• LAN", "keyColor": "#e8d27a"},
    {"type": "wifi", "key": "• WIFI", "format": "{ssid}", "keyColor": "#e8d27a"},
    "break",
    {"type": "colors", "symbol": "circle", "paddingLeft": 0}
  ]
}
