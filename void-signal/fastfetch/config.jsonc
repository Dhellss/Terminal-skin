{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#00f5ff",
      "2": "#2a8fa3",
      "3": "#b0e0e8",
      "4": "#eafcff",
      "5": "#0f4c5c"
    },
    "padding": {
      "top": 4,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#00f5ff",
      "output": "#cfeef4"
    },
    "key": {
      "width": 11
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "#00f5ff",
        "yellow": "#ffd166",
        "red": "#ff5470"
      }
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "─"
      },
      "border": {
        "left": "⟦",
        "right": "⟧"
      },
      "color": {
        "total": "#0d2a36",
        "border": "#5f8b99"
      },
      "width": 12
    }
  },
  "modules": [
    {"type": "custom", "format": "─⟦ ORIGIN ⟧─────────────────────────────", "outputColor": "#b0e0e8"},
    {"type": "title", "key": "▹ NODE", "format": "{user-name}@{host-name}"},
    {"type": "os", "key": "▹ OS", "format": "{name} {arch}"},
    {"type": "kernel", "key": "▹ KERNEL"},
    {"type": "uptime", "key": "▹ UPTIME"},
    {"type": "packages", "key": "▹ PKGS"},
    {"type": "shell", "key": "▹ SHELL"},
    {"type": "wm", "key": "▹ WM"},
    {"type": "terminal", "key": "▹ TERM"},
    {"type": "custom", "format": "─⟦ TRANSMISSION ⟧───────────────────────", "outputColor": "#b0e0e8"},
    {"type": "cpu", "key": "▹ CPU", "format": "{name} ×{cores-logical}"},
    {"type": "gpu", "key": "▹ GPU", "format": "{name}"},
    {"type": "memory", "key": "▹ RAM"},
    {"type": "disk", "key": "▹ DISK", "folders": "/"},
    {"type": "battery", "key": "▹ POWER"},
    {"type": "custom", "format": "─⟦ CARRIER ⟧────────────────────────────", "outputColor": "#b0e0e8"},
    {"type": "localip", "key": "▹ LAN", "keyColor": "#b0e0e8"},
    {"type": "wifi", "key": "▹ WIFI", "format": "{ssid}", "keyColor": "#b0e0e8"},
    "break",
    {"type": "colors", "symbol": "square", "paddingLeft": 0}
  ]
}
