{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#ff4500",
      "2": "#a31800",
      "3": "#ffb020",
      "4": "#fff1b0"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#ff4500",
      "output": "#ffd9b3"
    },
    "key": {
      "width": 11
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "#ffb020",
        "yellow": "#ffb020",
        "red": "#ff2a00"
      }
    },
    "bar": {
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {
        "total": "#2e0d02",
        "border": "#a8683f"
      },
      "width": 12
    }
  },
  "modules": [
    {"type": "custom", "format": "━[ BRIMSTONE ]━━━━━━━━━━━━━━━━━━━━━━━━━━", "outputColor": "#ffb020"},
    {"type": "title", "key": "▸ NODE", "format": "{user-name}@{host-name}"},
    {"type": "os", "key": "▸ OS", "format": "{name} {arch}"},
    {"type": "kernel", "key": "▸ KERNEL"},
    {"type": "uptime", "key": "▸ UPTIME"},
    {"type": "packages", "key": "▸ PKGS"},
    {"type": "shell", "key": "▸ SHELL"},
    {"type": "wm", "key": "▸ WM"},
    {"type": "terminal", "key": "▸ TERM"},
    {"type": "custom", "format": "━[ FURNACE ]━━━━━━━━━━━━━━━━━━━━━━━━━━━━", "outputColor": "#ffb020"},
    {"type": "cpu", "key": "▸ CPU", "format": "{name} ×{cores-logical}"},
    {"type": "gpu", "key": "▸ GPU", "format": "{name}"},
    {"type": "memory", "key": "▸ RAM"},
    {"type": "disk", "key": "▸ DISK", "folders": "/"},
    {"type": "battery", "key": "▸ POWER"},
    {"type": "custom", "format": "━[ HELLGATE ]━━━━━━━━━━━━━━━━━━━━━━━━━━━", "outputColor": "#ffb020"},
    {"type": "localip", "key": "▸ LAN", "keyColor": "#ffb020"},
    {"type": "wifi", "key": "▸ WIFI", "format": "{ssid}", "keyColor": "#ffb020"},
    "break",
    {"type": "colors", "symbol": "block", "paddingLeft": 0}
  ]
}
