{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": { "1": "green", "2": "cyan" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "green", "output": "white" },
    "key": { "width": 13 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "┌────────[ SYSTEM // ROOT ACCESS ]────────┐", "outputColor": "green" },
    { "type": "title", "key": "│ USER", "keyColor": "cyan", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "│ OS", "format": "{name} {arch}" },
    { "type": "kernel", "key": "│ KERNEL" },
    { "type": "uptime", "key": "│ UPTIME" },
    { "type": "packages", "key": "│ PKGS" },
    { "type": "shell", "key": "│ SHELL" },
    { "type": "wm", "key": "│ WM" },
    { "type": "terminal", "key": "│ TERM" },
    { "type": "custom", "format": "├────────[ HARDWARE ]─────────────────────┤", "outputColor": "green" },
    { "type": "cpu", "key": "│ CPU", "format": "{name} ({cores-logical})" },
    { "type": "gpu", "key": "│ GPU", "format": "{name}" },
    { "type": "memory", "key": "│ RAM" },
    { "type": "disk", "key": "│ DISK", "folders": "/" },
    { "type": "localip", "key": "│ LOCAL IP", "keyColor": "red" },
    { "type": "custom", "format": "└─────────────────────────────────────────┘", "outputColor": "green" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
