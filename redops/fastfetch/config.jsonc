{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "red", "2": "yellow" },
    "padding": { "top": 3, "left": 2, "right": 5 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "output": "white" },
    "key": { "width": 11 },
    "percent": { "type": 3 }
  },
  "modules": [
    { "type": "custom", "format": "─[ TARGET ]────────────────────────────", "outputColor": "yellow" },
    { "type": "title", "key": "› NODE", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "› OS", "format": "{name} {arch}" },
    { "type": "kernel", "key": "› KERNEL" },
    { "type": "uptime", "key": "› UPTIME" },
    { "type": "packages", "key": "› PKGS" },
    { "type": "shell", "key": "› SHELL" },
    { "type": "wm", "key": "› WM" },
    { "type": "custom", "format": "─[ PAYLOAD ]───────────────────────────", "outputColor": "yellow" },
    { "type": "cpu", "key": "› CPU", "format": "{name} ×{cores-logical}" },
    { "type": "gpu", "key": "› GPU", "format": "{name}" },
    { "type": "memory", "key": "› RAM" },
    { "type": "disk", "key": "› DISK", "folders": "/" },
    { "type": "battery", "key": "› POWER" },
    { "type": "custom", "format": "─[ UPLINK ]────────────────────────────", "outputColor": "yellow" },
    { "type": "localip", "key": "› LAN", "keyColor": "cyan" },
    { "type": "wifi", "key": "› WIFI", "keyColor": "cyan", "format": "{ssid}" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
