{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#a9d4f5",
      "2": "#5b93c7",
      "3": "#ffb3d1",
      "4": "#f4faff",
      "5": "#7fb3e0",
      "6": "#3a6a99"
    },
    "padding": {
      "top": 4,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#60b8ff",
      "output": "#e3f1ff"
    },
    "key": {
      "width": 11
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "#60b8ff",
        "yellow": "#ffd98a",
        "red": "#ff7a90"
      }
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "‿"
      },
      "border": {
        "left": "⟨",
        "right": "⟩"
      },
      "color": {
        "total": "#15263a",
        "border": "#7590ad"
      },
      "width": 12
    }
  },
  "modules": [
    {"type": "custom", "format": "─⟨ SKYLINE ⟩────────────────────────────", "outputColor": "#d6ebff"},
    {"type": "title", "key": "◦ NODE", "format": "{user-name}@{host-name}"},
    {"type": "os", "key": "◦ OS", "format": "{name} {arch}"},
    {"type": "kernel", "key": "◦ KERNEL"},
    {"type": "uptime", "key": "◦ UPTIME"},
    {"type": "packages", "key": "◦ PKGS"},
    {"type": "shell", "key": "◦ SHELL"},
    {"type": "wm", "key": "◦ WM"},
    {"type": "terminal", "key": "◦ TERM"},
    {"type": "custom", "format": "─⟨ ALTITUDE ⟩───────────────────────────", "outputColor": "#d6ebff"},
    {"type": "cpu", "key": "◦ CPU", "format": "{name} ×{cores-logical}"},
    {"type": "gpu", "key": "◦ GPU", "format": "{name}"},
    {"type": "memory", "key": "◦ RAM"},
    {"type": "disk", "key": "◦ DISK", "folders": "/"},
    {"type": "battery", "key": "◦ POWER"},
    {"type": "custom", "format": "─⟨ BREEZE ⟩─────────────────────────────", "outputColor": "#d6ebff"},
    {"type": "localip", "key": "◦ LAN", "keyColor": "#ffb3d1"},
    {"type": "wifi", "key": "◦ WIFI", "format": "{ssid}", "keyColor": "#ffb3d1"},
    "break",
    {"type": "colors", "symbol": "circle", "paddingLeft": 0}
  ]
}
